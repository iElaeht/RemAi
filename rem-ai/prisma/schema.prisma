// 1. Configuración del Cliente
generator client {
  provider = "prisma-client-js" // Corregido: el provider es prisma-client-js
  output   = "../lib/generated/prisma"
}

// 2. Fuente de datos
datasource db {
  provider = "postgresql"
}

// --- MODELOS DE DATOS ---

model User {
  id          String      @id // ID proveniente de Clerk
  email       String      @unique
  favorites   Favorite[]
  history     History[]
  comments    Comment[]
  communities Community[] @relation("CommunityMembers")
  createdAt   DateTime    @default(now())
}

model Manga {
  id          String      @id // ID original de MangaDex
  title       String
  coverUrl    String?
  favorites   Favorite[]
  history     History[]
  comments    Comment[]
  communities Community[]
}

model Favorite {
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  manga     Manga    @relation(fields: [mangaId], references: [id])
  mangaId   String
  createdAt DateTime @default(now())

  @@id([userId, mangaId]) // Llave compuesta para evitar duplicados
}

model History {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id])
  userId     String
  manga      Manga    @relation(fields: [mangaId], references: [id])
  mangaId    String
  chapterId  String
  lastReadAt DateTime @updatedAt
}

model Comment {
  id        String   @id @default(cuid())
  content   String?
  imageUrl  String?
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  manga     Manga    @relation(fields: [mangaId], references: [id])
  mangaId   String
  createdAt DateTime @default(now())
}

model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  mangaId     String
  manga       Manga    @relation(fields: [mangaId], references: [id])
  members     User[]   @relation("CommunityMembers")
}